{
  "version": 1,
  "transformers": {
    "cleanup": {
      "name": "cleanup",
      "description": "清理空行和首尾空白",
      "script": "function transform(content) {\n  return content\n    .split('\\n')\n    .map(line => line.trim())\n    .filter(line => line.length > 0)\n    .join('\\n');\n}"
    }
  },
  "rules": [
    {
      "name": "LocalAreaNetwork",
      "description": "本地局域网地址",
      "sources": [
        { "type": "url", "url": "https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/LocalAreaNetwork.list" }
      ],
      "output": { "clients": ["clash_meta", "shadowrocket"] }
    },
    {
