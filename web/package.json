{
  "name": "prm-admin-web",
  "private": true,
  "version": "0.1.2",
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:public": "vite --config vite.public.config.ts",
    "build:admin": "vite build",
    "build:public": "vite build --config vite.public.config.ts",
    "build": "pnpm build:admin && pnpm build:public",
