{
  "name": "app",
  "version": "0.4.1",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "concurrently -n fe,be -c cyan,green \"next dev\" \"DATA_DIR=$PWD/data PORT=3001 OUT_DIR=$PWD/out go run -C backend ./cmd/server -dev\"",
    "dev:fe": "next dev",
    "dev:be": "DATA_DIR=$PWD/data PORT=3001 OUT_DIR=$PWD/out go run -C backend ./cmd/server -dev",
    "build": "next build",
    "build:server": "cd backend && go build -trimpath -ldflags=\"-s -w -X github.com/fl0w1nd/proxy-rule-manager/backend/internal/api.Version=${npm_package_version}\" -o ../bin/proxy-rule-manager ./cmd/server",
    "start": "./bin/proxy-rule-manager",
    "test:backend": "cd backend && go test ./...",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@monaco-editor/react": "^4.7.0",
    "@pierre/diffs": "^1.0.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-virtual": "^3.13.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^8.0.3",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "monaco-editor": "^0.55.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
